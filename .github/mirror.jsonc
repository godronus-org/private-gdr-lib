// Public mirror (T34): on each release these tracked files are pushed to
// godronus-org/gdr-lib as one commit. Its CI is generated by the export (toolkit
// templates/public/); a library mirror gets no deploy workflow.
{
  "include": ["src/**", "Cargo.toml", "Cargo.lock", "README.md", ".gitignore", "CHANGELOG.md"]
}
